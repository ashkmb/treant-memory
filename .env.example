# Copy to .env (never commit .env). Used by compose.yml.
POSTGRES_PASSWORD=change-me-superuser
TREANT_LOGIN_PASSWORD=change-me-login

# Optional: an OpenAI-compatible chat endpoint for distillation, rewrites and the LLM judge.
# The worker posts to <TREANT_LITELLM_URL>/chat/completions with model = the workspace's alias
# (default "default"). One key per workspace: TREANT_LITELLM_KEY_<WORKSPACE IN CAPITALS>.
# compose.yml passes the key for the `personal` workspace; add a line there for each other one.
TREANT_LITELLM_URL=
TREANT_LITELLM_KEY_PERSONAL=

# Optional: the Jev judge (https://api.typesafe.ai). Off by default here: nothing reaches
# `general` unless you approve it yourself (treant general approve). To publish automatically,
# set TREANT_JEV=on and the key.
TREANT_JEV=off
TREANT_JEV_API_KEY=
