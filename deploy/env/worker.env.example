# /etc/treant/worker.env  (root:root 0600). Read by the `worker` service only.
#
# OpenAI-compatible base URL, including the version path; the worker POSTs to
# <TREANT_LITELLM_URL>/chat/completions. LiteLLM is one option; any compatible gateway works.
TREANT_LITELLM_URL=https://llm.example.com/v1

# One key per workspace: TREANT_LITELLM_KEY_<WORKSPACE NAME IN UPPER CASE>.
# A workspace with backend "litellm" (the default) and no key here gets no distillation:
# its jobs fail as model_unavailable and end up dead.
TREANT_LITELLM_KEY_PERSONAL=CHANGE_ME
TREANT_LITELLM_KEY_ACME=CHANGE_ME
TREANT_LITELLM_KEY_STARTUP=CHANGE_ME

# Jev judge, the second judge on writes to the shared `general` schema.
# Without a key no item is ever published to `general` automatically (see docs/deploy.md).
# TREANT_JEV=off never calls Jev: every item that passes the rules and the LLM judge waits for
# the owner's review instead (then leave TREANT_JEV_API_KEY empty).
# TREANT_JEV=on
TREANT_JEV_API_KEY=CHANGE_ME
# Optional overrides; the defaults are in src/treant/config.py.
# TREANT_JEV_URL=https://api.typesafe.ai
# TREANT_JEV_MODEL=jev-1.13.0
