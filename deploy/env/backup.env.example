# /etc/treant/backup.env  (root:root 0600). Read by deploy/scripts/backup.sh,
# restore-check.sh and purge.sh (and by treant-backup.service as its EnvironmentFile).
# RESTIC_* are restic's own variables; the others are read by the scripts only.
#
# Encrypts every repository. Keep a copy off the host: without it the backups are useless.
RESTIC_PASSWORD=CHANGE_ME
# Base of the per-schema restic repositories: <BACKUP_REPO_BASE>/<schema>. A local path
# (a mounted backup disk or NFS share) or any restic repository URL such as
# sftp:backup@backup.example.com:/srv/treant or s3:https://s3.example.com/bucket/treant.
# Add the backend's own credentials (for example AWS_ACCESS_KEY_ID) to this file if needed.
BACKUP_REPO_BASE=/srv/backups/treant
# restic forget policy, applied per schema after each backup.
BACKUP_KEEP="--keep-daily 7 --keep-weekly 4 --keep-monthly 12"
