# /etc/treant/admin.env  (root:root 0600). Read by the one-shot `admin` CLI only.
# Never give these two variables to the server, worker or dashboard.
#
# Superuser DSN: bootstrap, upgrade, workspace create/purge/purge-verify, schemas.
TREANT_ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME_SUPERUSER_PASSWORD@db:5432/treant
# Password that `treant bootstrap` sets on the <prefix>_login role. It must equal the
# password inside TREANT_DATABASE_URL in treant.env. 32+ alphanumeric characters.
TREANT_LOGIN_PASSWORD=CHANGE_ME_LOGIN_PASSWORD
