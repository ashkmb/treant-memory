# /etc/treant/treant.env  (root:root 0640). Read by server, worker, dashboard and admin.
# No admin variables and no model keys here.
#
# Login-role DSN. The role is <TREANT_ROLE_PREFIX>_login, created by `treant bootstrap`
# with the password from TREANT_LOGIN_PASSWORD (admin.env).
TREANT_DATABASE_URL=postgresql://treant_login:CHANGE_ME_LOGIN_PASSWORD@db:5432/treant
# Prefix of every database role Treant creates: [a-z][a-z0-9_]{0,23}. Default: treant.
TREANT_ROLE_PREFIX=treant

# Embedding service base URL; Treant appends /v1/embeddings. `embed` is the bundled
# llama.cpp service (profile `embed`); point this at your own service otherwise.
TREANT_EMBED_URL=http://embed:8080
# Sent as "model" in every embeddings request. Default: embeddinggemma-300m.
TREANT_EMBED_MODEL=embeddinggemma-300m
# Must be 768: the vector columns are vector(768). Default: 768.
TREANT_EMBED_DIMS=768

# MCP server listen address inside the container. Default: 127.0.0.1:8000, which is not
# reachable through a published port, so set 0.0.0.0 in a container.
TREANT_BIND=0.0.0.0:8000
# Comma-separated Host values the MCP endpoint accepts (exact match, port included when
# the client sends one). Browsers' Origin must then be https://<one of them>.
# Empty turns the Host/Origin check off and leaves the bearer token as the only gate.
TREANT_ALLOWED_HOSTS=treant.example.com
