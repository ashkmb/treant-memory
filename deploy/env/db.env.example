# /etc/treant/db.env  (root:root 0600). Read by the `db` service only.
# These are the Postgres image's own variables. The image reads them when it creates the
# cluster (first start, empty volume); changing the password here later does NOT change it
# in the database. See docs/deploy.md, "Key rotation".
#
# Use 32+ alphanumeric characters: the same password goes unencoded into the DSN in
# admin.env. Example generator: openssl rand -base64 36 | tr -d '/+='
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
POSTGRES_DB=treant
