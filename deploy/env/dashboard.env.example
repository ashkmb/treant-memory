# /etc/treant/dashboard.env  (root:root 0600). Read by the `dashboard` service only,
# on top of treant.env.
#
# Public origin of the dashboard: https://, a host, no path. The only Host it accepts,
# and the base of the OIDC redirect URI <TREANT_DASHBOARD_URL>/auth/callback.
TREANT_DASHBOARD_URL=https://treant-admin.example.com
# oidc (default): log in through the provider below. none: no login at all, every
# request acts as the single owner; only for a dashboard no one else can reach.
TREANT_DASHBOARD_AUTH=oidc
# Issuer exactly as the provider's discovery document states it (Authentik's
# per-application issuer keeps its trailing slash).
TREANT_OIDC_ISSUER=https://auth.example.com
TREANT_OIDC_CLIENT_ID=treant
TREANT_OIDC_CLIENT_SECRET=CHANGE_ME
# Signs the session cookie; 32+ characters. Changing it logs everyone out.
# Example generator: openssl rand -base64 48
TREANT_DASHBOARD_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
# Comma-separated preferred_username values allowed in (exactly one with AUTH=none).
TREANT_DASHBOARD_OWNERS=alice
# Group the owner must be in (userinfo "groups" claim). Default: treant.
TREANT_DASHBOARD_GROUP=treant
# Listen address inside the container. Default: 0.0.0.0:8001.
TREANT_DASHBOARD_BIND=0.0.0.0:8001
# Seconds a login counts as recent for sensitive actions. Default: 300.
TREANT_DASHBOARD_REAUTH_S=300
